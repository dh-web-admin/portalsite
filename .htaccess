RewriteEngine On

# Redirect to HTTPS (Railway provides SSL)
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ✅ Never route uploads through the app
RewriteRule ^(PortalSite/)?uploads/ - [L]

# ✅ Map public /uploads/* to mounted volume folder
RewriteRule ^uploads/(.*)$ /portalsite/uploads/$1 [L,PT]
RewriteRule ^PortalSite/uploads/(.*)$ /portalsite/uploads/$1 [L,PT]

# Don't rewrite files or directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Security: Block access to sensitive files
<FilesMatch "^(config\.php|\.git|\.env)">
    Order allow,deny
    Deny from all
</FilesMatch>

# P5 — never serve credentials, internal notes, DB dumps, backups or logs.
# .php tools under dev/ and debug/ keep working; only these extensions/names are denied.
<FilesMatch "(?i)\.(sql|log|md|txt|bak|old|ini|conf|dist|example|sh|py|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
# Only for files that AREN'T normal served application code (.php/.css/.js) —
# those substrings are common in legitimate filenames (password_reset.css,
# change_own_password.php, etc). This block is for stray leaked secrets:
# db_credentials.txt, a .pem/.key, mysql_access.log.
<FilesMatch "(?i)^(?!.*\.(php|css|js)$).*(secret|token|credential|passwd|password|mysql_access|\.pem|\.key).*$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<FilesMatch "(?i)^(config(\.railway|\.example|\.local)?\.php|composer\.(json|lock)|package(-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# P5 — the attacker playbook / assessment report must never be web-served if it lands here.
<FilesMatch "(?i)(portal-breakin|portal-patch-set|security-audit|php-security-audit)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

ErrorDocument 404 /index.php
ErrorDocument 500 /index.php

Options -Indexes

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>
